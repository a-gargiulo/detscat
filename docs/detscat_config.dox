/**
 *
 * @struct DetScatConfig
 * @brief Structured data container for the configuration file parameters.
 *
 * This struct stores all required user input parameters, as defined in the
 * configuration file. It serves as a central container for accessing parsed
 * configuration values throughout the application.
 *
 * See @ref config_file_format for details on the expected configuration file
 * format.
 */
